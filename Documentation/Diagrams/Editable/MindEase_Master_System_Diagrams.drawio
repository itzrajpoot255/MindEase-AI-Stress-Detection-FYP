" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=1.5;fontFamily=Arial;fontSize=11;" vertex="1"><mxGeometry x="780" y="550" width="240" height="90" as="geometry" /></mxCell><mxCell id="8" parent="1" value="&lt;b&gt;Clinical Intervention&lt;/b&gt;&lt;br&gt;--&lt;br&gt;entry / Share Consented XAI Dossier&lt;br&gt;do / Conduct 1-on-1 Counseling Session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7e22ce;strokeWidth=1.5;fontFamily=Arial;fontSize=11;" vertex="1"><mxGeometry x="480" y="550" width="230" height="90" as="geometry" /></mxCell><mxCell id="9" parent="1" style="shape=ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#0f172a;strokeWidth=2;" vertex="1"><mxGeometry x="1180" y="360" width="30" height="30" as="geometry" /></mxCell><mxCell id="10" parent="1" value="Student Onboarding" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1e3a8a;strokeWidth=1.5;" edge="1" source="3" target="4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="11" parent="1" value="[PSS Score 14-26 or Acoustic Drift &amp;gt; 15%]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1e3a8a;strokeWidth=1.5;" edge="1" source="4" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="12" parent="1" value="[BiLSTM Fusion &amp;gt; 0.65]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;strokeWidth=1.5;" edge="1" source="5" target="6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="13" parent="1" value="[Score &amp;gt;= 27 or Crisis NLP Keyword]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=1.5;" edge="1" source="6" target="7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="14" parent="1" value="Free Triage Booking Confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7e22ce;strokeWidth=1.5;" edge="1" source="7" target="8"><mxGeometry relative