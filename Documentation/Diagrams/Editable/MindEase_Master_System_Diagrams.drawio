mxGraphModel></diagram><diagram id="tab_10_Database_Schema" name="10_Database_Schema"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" parent="1" value="Figure 5.5.2: Relational Database Physical Schema for MindEase Platform" style="shape=umlFrame;whiteSpace=wrap;html=1;width=480;height=35;fillColor=#ffffff;strokeColor=#0f172a;strokeWidth=1.5;fontFamily=Arial;fontSize=13;fontStyle=1;" vertex="1"><mxGeometry x="30" y="20" width="1440" height="950" as="geometry" /></mxCell><mxCell id="3" parent="1" value="&lt;b&gt;public.users&lt;/b&gt;&lt;br&gt;--&lt;br&gt;PK user_id: UUID (gen_random_uuid())&lt;br&gt;email: VARCHAR(255) UNIQUE NOT NULL&lt;br&gt;password_hash: VARCHAR(255) NOT NULL&lt;br&gt;role: VARCHAR(20) DEFAULT 'student'&lt;br&gt;is_verified: BOOLEAN DEFAULT FALSE&lt;br&gt;created_at: TIMESTAMPTZ DEFAULT now()" style="swimlane;fontStyle=0;startSize=24;fillColor=#eff6ff;strokeColor=#1e3a8a;strokeWidth=1.5;fontFamily=Arial;fontSize=10;" vertex="1"><mxGeometry x="600" y="70" width="260" height="140" as="geometry" /></mxCell><mxCell id="4" parent="1" value="&lt;b&gt;public.students&lt;/b&gt;&lt;br&gt;--&lt;br&gt;PK,FK student_id: UUID REFERENCES users(user_id)&lt;br&gt;reg_number: VARCHAR(50) UNIQUE&lt;br&gt;department: VARCHAR(100)&lt;br&gt;semester: INTEGER&lt;br&gt;baseline_score: NUMERIC(4,2) DEFAULT 14.0" style="swimlane;fontStyle=0;startSize=24;fillColor=#f8fafc;strokeColor=#1e3a8a;strokeWidth=1.5;fontFamily=Arial;fontSize=10;" vertex="1"><mxGeometry x="250" y="270" width="270" height="135" as="geometry" /></mxCell><mxCell id="5" parent="1" value="&lt;b&gt;public.counselors&lt;/b&gt;&lt;br&gt;--&lt;br&gt;PK,FK counselor_id: UUID REFERENCES users(user_id)&lt;br&gt;license_no: VARCHAR(50) UNIQUE&lt;br&gt;specialization: VARCHAR(100)&lt;br&gt;hourly_rate: NUMERIC(8,2) DEFAULT 0.0&lt;br&gt;is_approved: BOOLEAN DEFAULT FALSE" style="swimlane;fontStyle=0;startSize=24;fillColor=#f8fafc;strokeColor=#1e3a8a;strokeWidth=1.5;fontFamily=Arial;fontSize=10;" vertex="1"><mxGeometry x="920" y="270" width="270" height="135" as="geometry" /></mxCell><mxCell id="6" parent="1" value="&lt;b&gt;public.stress_logs&lt;/b&gt;&lt;br&gt;--&lt;br&gt;PK log_id: UUID&lt;br&gt;FK student_id: UUID REFERENCES students(student_id)&lt;br&gt;pss_score: INT CHECK (pss_score BETWEEN 0 AND 40)&lt;br&gt;speech_score: NUMERIC(4,2)&lt;br&gt;multimodal_score: NUMERIC(4,2)&lt;br&gt;tier: VARCHAR(20) CHECK (tier IN ('MILD','MODERATE','SEVERE'))&lt;br&gt;created_at: TIMESTAMPTZ DEFAULT now()" style="swimlane;fontStyle=0;startSize=24;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontFamily=Arial;fontSize=10;" vertex="1"><mxGeometry x="60" y="480" width="260" height="165" as="geometry" /></mxCell><mxCell id="7" parent="1" value="&lt;b&gt;public.voice_diaries&lt;/b&gt;&lt;br&gt;--&lt;br&gt;PK entry_id: UUID&lt;br&gt;FK student_id: UUID REFERENCES students(student_id)&lt;br&gt;audio_vault_path: TEXT NOT NULL&lt;br&gt;transcript_text: TEXT&lt;br&gt;detected_lang: VARCHAR(20)&lt;br&gt;acoustic_pitch: NUMERIC(6,2)&lt;br&gt;recorded_at: TIMESTAMPTZ DEFAULT now()" style="swimlane;fontStyle=0;startSize=24;fillColor=#f8fafc;strokeColor=#1e3a8a;strokeWidth=1.5;fontFamily=Arial;fontSize=10;" vertex="1"><mxGeometry x="370" y="480" width="260" height="165" as="geometry" /></mxCell><mxCell id="8" parent="1" value="&lt;b&gt;public.study_plans&lt;/b&gt;&lt;br&gt;--&lt;br&gt;PK plan_id: UUID&lt;br&gt;FK student_id: UUID REFERENCES students(student_id)&lt;br&gt;focus_minutes: INT DEFAULT 25&lt;br&gt;break_minutes: INT DEFAULT 5&lt;br&gt;is_adapted: BOOLEAN DEFAULT FALSE&lt;br&gt;plan_date: DATE DEFAULT CURRENT_DATE" style="swimlane;fontStyle=0;startSize=24;fillColor=#f8fafc;strokeColor=#1e3a8a;strokeWidth=1.5;fontFamily=Arial;fontSize=10;" vertex="1"><mxGeometry x="220" y="720" width="260" height="150" as="geometry" /></mxCell><mxCell id="9" parent="1" value="&lt;b&gt;public.appointments&lt;/b&gt;&lt;br&gt;--&lt;br&gt;PK booking_id: UUID&lt;br&gt;FK student_id: UUID REFERENCES students(student_id)&lt;br&gt;FK counselor_id: UUID REFERENCES counselors(counselor_id)&lt;br&gt;scheduled_slot: TIMESTAMPTZ NOT NULL&lt;br&gt;status: VARCHAR(20) DEFAULT 'PENDING'&lt;br&gt;clinical_notes: TEXT" style="swimlane;fontStyle=0;startSize=24;fillColor=#f8fafc;strokeColor=#1e3a8a;strokeWidth=1.5;fontFamily=Arial;fontSize=10;" vertex="1"><mxGeometry x="780" y="480" width="270" height="165" as="geometry" /></mxCell><mxCell id="10" parent="1" value="&lt;b&gt;public.payments&lt;/b&gt;&lt;br&gt;--&lt;br&gt;PK payment_id: UUID&lt;br&gt;FK booking_id: UUID REFERENCES appointments(booking_id)&lt;br&gt;polar_order_id: VARCHAR(100) UNIQUE&lt;br&gt;amount_paid: NUMERIC(8,2) NOT NULL&lt;br&gt;payment_status: VARCHAR(20) DEFAULT 'PAID'&lt;br&gt;verified_at: TIMESTAMPTZ" style="swimlane;fontStyle=0;startSize=24;fillColor=#f8fafc;strokeColor=#1e3a8a;strokeWidth=1.5;fontFamily=Arial;fontSize=10;" vertex="1"><mxGeometry x="780" y="720" width="270" height="150" as="geometry" /></mxCell><mxCell id="11" parent="1" value="&lt;b&gt;public.community_posts&lt;/b&gt;&lt;br&gt;--&lt;br&gt;PK post_id: UUID&lt;br&gt;FK student_id: UUID REFERENCES students(student_id)&lt;br&gt;is_anonymous: BOOLEAN DEFAULT TRUE&lt;br&gt;content_text: TEXT NOT NULL&lt;br&gt;flag_count: INT DEFAULT 0&lt;br&gt;is_hidden: BOOLEAN DEFAULT FALSE" style="swimlane;fontStyle=0;startSize=24;fillColor=#f8fafc;strokeColor=#1e3a8a;strokeWidth=1.5;fontFamily=Arial;fontSize=10;" vertex="1"><mxGeometry x="1130" y="480" width="260" height="165" as="geometry" /></mxCell><mxCell id="12" parent="1" value="FK user_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1e3a8a;strokeWidth=1.3;" edge="1" source="4" target="3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell i